# PostgreSQL (Vercel Postgres / Neon). Copie a "Connection string" do painel da Vercel.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredos dos tokens JWT. Gere valores aleatórios longos, nunca reutilize entre ambientes.
JWT_ACCESS_SECRET="troque-por-um-valor-aleatorio-longo"
JWT_REFRESH_SECRET="troque-por-outro-valor-aleatorio-longo"

PORT=3333
NODE_ENV=development

# Origem permitida para CORS (frontend Vite em dev)
WEB_ORIGIN="http://localhost:5173"

# Só coloque "true" em produção se a API estiver atrás de um proxy reverso confiável
# (Vercel, nginx, load balancer). Sem um proxy real, isso permite forjar o IP do
# cliente via cabeçalho X-Forwarded-For e burlar rate limiting/auditoria.
TRUST_PROXY=false
